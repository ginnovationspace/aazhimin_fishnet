    "@aazhimin/types": "workspace:*",
    "@aazhimin/ui": "workspace:*",
    "@aazhimin/validation": "workspace:*",
    "axios": "^1.12.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "express": "^4.18.3",
    "express-fileupload": "^1.4.0",
    "express-rate-limit": "^6.10.0",
    "form-data": "^4.0.4",
    "morgan": "^1.10.1",
    "nanoid": "^5.0.6",
    "node-fetch": "^3.3.2",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.3.3",
    "@types/winston": "^2.4.0",
    "typescript": "^5.9.2",
    "ts-node-dev": "^2.0.0",
    "eslint": "^8",
    "jest": "^29.0.0"
