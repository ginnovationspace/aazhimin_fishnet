{
  "packageManager": "pnpm@8.15.0",
  "root": ".",
  "builds": [
    {
      "src": "apps/web/**",
      "use": "@vercel/next",
      "config": {
        "distDir": ".next"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "apps/api/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_APP_URL": "https://fishnet.vercel.app",
    "API_URL": "https://fishnet-api.vercel.app"
  }
}